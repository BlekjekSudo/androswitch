# Rust / Cargo
/target/
**/*.rs.bk
Cargo.lock.bak

# Build artifacts
/dist/
/bins/

# Golden APK test artifacts (binaries are never committed — see golden-apks/)
/golden-apks/*.apk
/golden-apks/*.apkm
/golden-apks/*.xapk
/golden-apks/cache/

# Runtime state
*.log
*.snapshot
/state/

# Environment & secrets (NEVER commit tokens)
.env
.env.*
*.pem
*.key

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
__pycache__/

# cargo-fuzz artifacts
crates/*/fuzz/target
crates/*/fuzz/Cargo.lock
crates/*/fuzz/artifacts
crates/*/fuzz/coverage
crates/*/fuzz/corpus

# Golden VM harness (política GH-05: jars/binários nunca commitados — ver golden/vm/README.md)
/golden/vm/cache/
/golden/vm/build/

# local fuzz campaign logs (scripts/fuzz-campaign.sh)
fuzz-logs/

# Native ABI fixtures are rebuilt from source
/golden/native/artifacts/

# Agent session/process logs never belong in git (team rule, 2026-10-25).
# History stays in git log; status lives in docs/ and ROADMAP.
# worklog.md stays tracked as a short onboarding guide (owner decision).
/PROGRESS-*.md
