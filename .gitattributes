# Normalize line endings
* text=auto eol=lf

# Source files always LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Preserve the pinned AOSP header byte-for-byte, including its final blank line.
third_party/android/jni.h whitespace=-blank-at-eof
third_party/fonts/DejaVu.LICENSE whitespace=-blank-at-eol
third_party/android/opensles/* whitespace=-blank-at-eol,-blank-at-eof

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.apk binary
*.so binary
