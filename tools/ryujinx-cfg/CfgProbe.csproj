<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>../../local-artifacts/m9/ryujinx-cfg-fix/probe-build/bin/</BaseOutputPath>
  </PropertyGroup>
  <Target Name="RequireRyujinxSource" BeforeTargets="ResolveProjectReferences" Condition="'$(RyujinxSource)' == ''">
    <Error Text="Pass -p:RyujinxSource=absolute/path/to/exact/e2143d4/source" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(RyujinxSource)/src/Ryujinx.Cpu/Ryujinx.Cpu.csproj" />
  </ItemGroup>
</Project>
